{
  "type": "object",
  "additionalProperties": false,
  "required": ["optionen"],
  "properties": {
    "optionen": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["befehl", "erklaerung", "risiko"],
        "properties": {
          "befehl": {
            "type": "string",
            "minLength": 1,
            "description": "ausführbarer Einzeiler"
          },
          "erklaerung": {
            "type": "string",
            "description": "was der Befehl tut, inkl. der wichtigen Flags"
          },
          "risiko": {
            "type": "string",
            "enum": ["niedrig", "mittel", "hoch"]
          }
        }
      }
    },
    "hinweis": {
      "type": "string",
      "description": "optional: Warnungen, Voraussetzungen, Alternativen"
    }
  }
}
